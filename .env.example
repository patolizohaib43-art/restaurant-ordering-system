# ==========================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---------------- Database (PostgreSQL) ----------------
# Works the same on Vercel Postgres, Supabase, Railway, Neon,
# or a self-hosted Postgres instance on a Linux VPS.
DATABASE_URL="postgresql://neondb_owner:npg_d2ClrxbNJqy1@ep-lingering-block-aet73yj3-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------- Admin Auth (JWT) ----------------
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET="K7hisHLp7FSuayn3d5BjaBbYlmrubh4DYTXYd3Xqn7vFgM8Tf6ywQJjyj8Zf+FcK"
JWT_EXPIRES_IN="7d"

# Cookie name used to store the admin session token
ADMIN_SESSION_COOKIE_NAME="restaurant_admin_session"

# ---------------- App Config ----------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Zaiqa-e-Sindh"

# IANA timezone the restaurant operates in, e.g. "Asia/Karachi",
# "America/New_York", "Europe/London". Used to compute "today"/"this
# month" consistently for Reports, the admin Dashboard, and the "open
# now" check — regardless of what timezone the server/host itself runs
# in (Vercel functions default to UTC; a VPS may be set to anything).
# Defaults to "UTC" if unset — set this explicitly in production.
RESTAURANT_TIMEZONE="UTC"

# Node environment (development | production | test)
NODE_ENV="development"

# ---------------- Order Tracking ----------------
# Length (in bytes) of the secure random tracking token generated per order
ORDER_TRACKING_TOKEN_BYTES=24

# ---------------- Optional: Seed / First Admin ----------------
# Used only by prisma/seed.ts to create the first admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Zaiqa-e-Sindh"

# ---------------- Image Uploads ----------------
# Where uploaded product/category/deal/restaurant images are written on
# disk. Leave unset for the Vercel demo and local development — it
# defaults to `public/uploads`, served automatically by Next.js.
#
# On a VPS, set this to a persistent path OUTSIDE the app's source
# folder so a redeploy (git pull + rebuild) never touches it, e.g.:
# UPLOAD_DIR="/var/www/zaika-e-sindh/uploads"
#
# Images are then served through /api/uploads/... automatically — no
# other configuration or code change needed. See VPS_DEPLOYMENT.md for
# the one-time folder + permissions setup.
# ---------------- Image Uploads (Cloudinary) ----------------
# Direct gallery/file uploads (Products, Categories, Deals, Restaurant
# logo) are stored on Cloudinary — persistent, Vercel-compatible storage
# (the serverless filesystem is wiped on every deploy/cold start, so it
# can never be used for this). Free tier is enough for a single
# restaurant's images.
#
# 1. Sign up free at https://cloudinary.com
# 2. Dashboard home page shows all three values below immediately after
#    signup — copy them directly, no extra setup needed.
# 3. Without these set, uploads are disabled and the admin sees a clear
#    error telling them to paste an Image URL instead — nothing falls
#    back to local storage.
CLOUDINARY_CLOUD_NAME="jhbqcivp"
CLOUDINARY_API_KEY="659756128786746"
CLOUDINARY_API_SECRET="_MNPMIOQJmrmmHVo5sNc6E_mFPM"

UPLOAD_DIR=""

# ---------------- Web Push (Phase 11) ----------------
# Real background push notifications for new orders — reaches the admin's
# Android/browser notification panel even with the admin panel fully
# closed. Requires HTTPS in production (Vercel and any VPS behind Nginx +
# Let's Encrypt both satisfy this automatically; localhost is fine for
# dev). Without these three set, push is silently skipped — everything
# else (in-app bell, browser Notifications while a tab is open, sound)
# keeps working regardless.
#
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
#
# Paste the output below. NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose
# to the browser (it's sent to the client by design, see
# PushNotificationSetup.tsx) — VAPID_PRIVATE_KEY must NEVER be exposed to
# the frontend or committed anywhere public.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BBFFYHZFODTwmr5HnBRQjjA7U-Ly-geqSpEtfQfZiI-3ELYQfz4iSblQwTbL8rU9ISZYVMV2vSO9KAjAm8tw8F4"
VAPID_PRIVATE_KEY="SZA5yzD0ETsudOCOh9BfWN1rZzXfTv9jG3vipw2eFZA"
# An email or URL the push service can contact if it needs to reach you
# about this application (required by the Web Push spec, not shown to
# users).
VAPID_SUBJECT="mailto:patolizohaib43@gmail.com"
